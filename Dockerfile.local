FROM jsreport/worker:local
USER root

# install extra fonts
RUN apt-get update && \
    apt-get install -y fonts-dejavu-core fonts-dejavu-extra fonts-droid-fallback fonts-tlwg-garuda fonts-tlwg-kinnari fonts-tlwg-laksaman fonts-tlwg-loma fonts-tlwg-mono fonts-tlwg-norasi fonts-tlwg-purisa fonts-tlwg-sawasdee fonts-tlwg-typewriter fonts-tlwg-typist fonts-tlwg-typo fonts-tlwg-umpush fonts-tlwg-waree

# cleanup
RUN rm -rf /var/lib/apt/lists/* /var/cache/apt/* && \
    rm -rf /src/*.deb && \
    rm -rf /tmp/*

USER jsreport:jsreport

COPY --chown=jsreport:jsreport jo /app/jo
COPY --chown=jsreport:jsreport ./bootstrap/* /app/bootstrap

RUN yarn install

# dependencies used in code
# (request and moment are needed as part of support for allowed modules
# inside scripts, helpers)
RUN yarn add --ignore-workspace-root-check request@2.88.2 moment@2.31.0 underscore@1.13.8
# this part is commented because copying the patches to node_modules/<path>
# does not work on symlinks (like when target is a package in the monorepo),
# but since we don't need patch for our local testing, we skip it
# COPY --chown=jsreport:jsreport patch /app

RUN yarn cache clean --all && rm -rf /tmp/*

# extensions from packages should already be there in the jsreport/worker image
# we just need to define the env var locations for the rest of extensions
ENV extensions_ejs=/app/packages/jsreport-ejs
ENV extensions_pug=/app/packages/jsreport-pug
ENV extensions_jo=/app/jo

USER root

CMD ["node", "server.js"]
